#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Start Up Shell Script
# ----------------------------------------------------------------------------

# 查找 Java
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

# 查找项目根目录
PRG="$0"
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG="`dirname "$PRG"`/$link"
    fi
done
SAVED="`pwd`"
cd "`dirname "$PRG"`/" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED" >/dev/null

# 确定 wrapper jar 路径
if [ ! -f "$APP_HOME/.mvn/wrapper/maven-wrapper.jar" ]; then
    echo "Maven Wrapper jar 缺失，正在下载..."
    if command -v curl > /dev/null 2>&1; then
        curl -L -o "$APP_HOME/.mvn/wrapper/maven-wrapper.jar" \
            "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
    elif command -v wget > /dev/null 2>&1; then
        wget -O "$APP_HOME/.mvn/wrapper/maven-wrapper.jar" \
            "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
    fi
fi

MAVEN_OPTS="${MAVEN_OPTS:--Xmx512m}"
export MAVEN_OPTS

exec "$JAVACMD" \
    $MAVEN_OPTS \
    -classpath "$APP_HOME/.mvn/wrapper/maven-wrapper.jar" \
    "-Dmaven.multiModuleProjectDirectory=$APP_HOME" \
    org.apache.maven.wrapper.MavenWrapperMain \
    ${1+"$@"}
